{
  "name": "orbit-platform",
  "version": "1.4.0-local-subscription",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --import tsx src/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:e2e": "node --import tsx test/e2e/workflow.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "test:browser": "node --import tsx test/e2e/browser.ts",
    "format": "prettier --write src packages scripts test *.ts *.json *.md",
    "format:check": "prettier --check src packages scripts test *.ts *.json *.md",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:live": "node --import tsx scripts/live-smoke.ts",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:gsc": "node --import tsx scripts/gsc-smoke.ts",
    "test:browser:isolated": "node --import tsx test/e2e/browser-runner.ts",
    "auth:provision": "node --import tsx scripts/provision-user.ts",
    "staging:config": "node ops/create-staging-config.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "test:staging": "node --import tsx test/staging/verify.ts",
    "test:backup": "node --import tsx test/staging/backup.ts",
    "security:check": "node ops/security-check.mjs",
    "verify:subscriptions": "node scripts/verify-subscriptions.mjs",
    "local": "node ops/local.mjs",
    "test:local": "node --import tsx test/e2e/local-mode.ts",
    "test:subscription:e2e": "node --import tsx test/e2e/subscription.ts",
    "subscription:status": "node --import tsx scripts/subscription-status.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
