{
  admin off
  auto_https disable_redirects
}
https://{$ORBIT_HOSTNAME:localhost} {
  tls internal
  encode zstd gzip
  request_body {
    max_size 6MB
  }
  reverse_proxy web:3000 {
    header_up X-Orbit-Client-IP {http.request.remote.host}
    header_down Strict-Transport-Security "max-age=31536000"
  }
}
