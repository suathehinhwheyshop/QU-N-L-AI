# Values must be configured on the server. Do not commit .env.local.
# scripts/setup-local.mjs generates random development credentials without printing them.
DATABASE_URL=
ORBIT_SESSION_SECRET=
ORBIT_ADMIN_PASSWORD=
ORBIT_BASE_URL=http://127.0.0.1:3200
ORBIT_COOKIE_SECURE=false
ORBIT_STORAGE_DIR=.orbit/artifacts
# AI/GSC credentials are intentionally absent: real adapters are Phase 2/3.
