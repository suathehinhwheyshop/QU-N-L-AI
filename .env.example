# Values must be configured on the server. Do not commit .env.local.
# scripts/setup-local.mjs creates random local DB secrets. Provision login accounts with auth:provision.
DATABASE_URL=
ORBIT_SESSION_SECRET=
ORBIT_BASE_URL=http://127.0.0.1:3200
ORBIT_COOKIE_SECURE=false
ORBIT_STORAGE_DIR=.orbit/artifacts
# Optional Phase 2 credentials: server-only, configure securely, never NEXT_PUBLIC_*.
# Paid chat subscriptions do not supply API credit or API credentials.
ORBIT_OPENAI_API_KEY=
ORBIT_ANTHROPIC_API_KEY=
ORBIT_GOOGLE_API_KEY=
ORBIT_XAI_API_KEY=
# GSC credentials are Phase 3. Model/pricing are configured through Connections.

# Phase 3 server-only Google OAuth web client; redirect = ORBIT_BASE_URL/api/gsc/oauth/callback
ORBIT_GSC_CLIENT_ID=
ORBIT_GSC_CLIENT_SECRET=
# Base64 of 32 random bytes; setup:local creates one for development. Back up securely.
ORBIT_TOKEN_ENCRYPTION_KEY=

ORBIT_ENV=development
# Rotation only during maintenance, remove after rewrapping all accounts.
ORBIT_TOKEN_ENCRYPTION_PREVIOUS_KEY=
